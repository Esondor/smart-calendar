# Nothing is required here: the admin sets the public address and Google sign-in inside the app
# (Settings → Server), every user connects their own calendars in the setup assistant.
# Portainer: optional "Environment variables" of the stack. Plain docker compose: copy to .env

# TZ=Europe/Berlin
# APP_PATH=/volume1/docker/smart-calendar     (the app's folder: data/ and backups/ are created in it)
# HOST_PORT=8097

# Optional overrides of the in-app server settings
# BASE_URL=https://plan.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_SECRET=at-least-32-random-characters   (otherwise generated once into the data folder)
